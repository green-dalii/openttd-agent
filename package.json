{
	"name": "openttd-agent",
	"version": "0.0.1",
	"description": "LLM agent framework that autonomously plays and self-evolves inside OpenTTD via Admin Port + in-game Bridge GS/Executor AI",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint . --ext .ts",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:live": "LIVE_TESTS=1 vitest --run",
		"gate": "npm run typecheck && npm run lint && npm test",
		"cli": "tsx src/cli/run.ts"
	},
	"dependencies": {
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"eslint": "^9.17.0",
		"tsx": "^4.23.13",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.0",
		"vitest": "^2.1.8"
	}
}
