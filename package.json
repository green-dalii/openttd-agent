{
  "name": "openttd-agent",
  "version": "0.6.0",
  "license": "MIT",
  "description": "LLM agent framework that autonomously plays and self-evolves inside OpenTTD via Admin Port + in-game Bridge GS/Executor AI",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.frontend.json",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:live": "LIVE_TESTS=1 vitest --run",
    "gate": "pnpm run typecheck && pnpm run lint && pnpm run vendor:check && pnpm test",
    "cli": "tsx src/cli/run.ts",
    "e2e": "bash scripts/e2e-agent.sh",
    "vendor": "tsx scripts/sync-vendor.ts",
    "vendor:check": "tsx scripts/verify-vendor.ts",
    "dashboard:smoke": "node scripts/dashboard-smoke.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "alpinejs": "^3.17.2",
    "eslint": "^9.17.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "uplot": "^1.6.32",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@esbuild/darwin-arm64"
    ]
  }
}
